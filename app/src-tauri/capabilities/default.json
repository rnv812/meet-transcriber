{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Права окон панели и настроек. В Tauri 2 системные команды закрыты по умолчанию: без этого файла окно нельзя ни потащить, ни спрятать — вызов отвергается с указанием недостающего права.",
  "windows": [
    "panel",
    "settings",
    "editor"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-is-visible",
    "core:window:allow-set-size",
    "core:event:default",
    "core:window:allow-close"
  ]
}
