{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "meet",
  "version": "0.1.0",
  "identifier": "com.meet.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:* http://localhost:* ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "meet",
    "copyright": "Copyright 2026 Andrey Aleynikov, Nikita Reznikov, ndrsvh",
    "license": "Apache-2.0",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "languages": [
          "Russian",
          "English"
        ],
        "customLanguageFiles": {
          "Russian": "./windows/lang/Russian.nsh",
          "English": "./windows/lang/English.nsh"
        }
      }
    }
  }
}
